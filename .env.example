# Optional. Copy to .env to turn on "<buzzword> summary", "<buzzword> ask" and npm run summarise.
# Everything else (spam deletion, ping/check, files/send, archive, transcripts) works without it.
# Fill in ONE of these, to match summary.provider in config.json:

# summary.provider "api": a Claude Console API key, billed to API credits.
ANTHROPIC_API_KEY=

# summary.provider "claude-code": your own Claude subscription, through the claude program. Create the token with
# `claude setup-token` (it lasts one year); only you can start these runs.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional, for "<buzzword> github ..." in chats linked to a repository (npm run github -- "<chat>" --repo OWNER/REPO).
# A fine-grained token limited to those repositories, with Contents, Issues and Pull requests: Read and write.
# The bot reads it at each use, so no restart is needed after adding it.
GITHUB_TOKEN=

# Optional, for Google Docs, Sheets and Slides linked to chats (npm run google -- "<chat>" --add <link> --name <name>).
# The path of a Google service account key file (JSON), kept outside the bot folder and readable only by you
# (chmod 600). Share each file with the service account's email. Read at each use, so no restart is needed.
GOOGLE_SERVICE_ACCOUNT_FILE=
